{
  "name": "audioframe-web",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "bun run ffmpeg:assets && bunx --bun next dev",
    "build": "bun run ffmpeg:assets && bunx --bun next build",
    "start": "bunx --bun next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "lint:staged": "lint-staged",
    "commit:check": "bun scripts/pre-commit.mjs",
    "test:hooks": "bun test scripts/pre-commit.test.mjs",
    "test:media": "bun test lib/ffmpeg.test.mjs",
    "ffmpeg:assets": "bun scripts/sync-ffmpeg-assets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bunx --bun next typegen && tsc --noEmit --incremental false",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test:hooks && bun run test:media",
    "prepare": "bun run ffmpeg:assets && husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@phosphor-icons/react": "^2.1.10",
    "@uidotdev/usehooks": "^2.4.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "framer-motion": "^14.1.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-h5-audio-player": "^3.10.2",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "semver": "^7.8.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.0",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
