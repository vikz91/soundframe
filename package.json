{
  "name": "audioframe-web",
  "version": "0.1.10",
  "private": true,
  "scripts": {
    "dev": "bun run ffmpeg:assets && bunx --bun next dev",
    "build": "bun run ffmpeg:assets && bunx --bun next build",
    "start": "bunx --bun next start",
    "lint": "oxlint . --max-warnings=0",
    "lint:fix": "oxlint . --fix --max-warnings=0",
    "lint:types": "bunx --bun next typegen && oxlint -c .oxlintrc.type-aware.json . --max-warnings=0",
    "lint:staged": "lint-staged",
    "commit:check": "bun scripts/pre-commit.mjs",
    "test:hooks": "bun test scripts/pre-commit.test.mjs",
    "test:media": "bun test scripts/ffmpeg-core.test.mjs lib/ffmpeg.test.mjs lib/browser-files.test.mjs lib/local-file.test.mjs lib/local-media.test.mjs lib/media-capabilities.test.mjs lib/editor/*.test.mjs",
    "test:tooling": "bun test scripts/quality-tools.test.mjs scripts/vercel-ignore-build.test.mjs",
    "ffmpeg:assets": "bun scripts/sync-ffmpeg-assets.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "bunx --bun next typegen && tsc --noEmit --incremental false",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run lint:types && bun run test:hooks && bun run test:media && bun run test:tooling",
    "prepare": "bun run ffmpeg:assets && husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@phosphor-icons/react": "^2.1.10",
    "@uidotdev/usehooks": "^2.4.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "framer-motion": "^14.1.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-h5-audio-player": "^3.10.2",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "semver": "^7.8.5",
    "tailwindcss": "^4",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.0",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
